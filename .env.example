# Copy to .env and fill in. No real values belong in this file.

# --- Database ---
# pgvector is required by the long-term memory work; the base image carries it.
DATABASE_DSN=postgres://sonari:sonari@localhost:5432/sonari
POSTGRES_USER=sonari
POSTGRES_PASSWORD=sonari
POSTGRES_DB=sonari

# --- LiveKit ---
# devkey/secret are LiveKit's documented dev-mode credentials. Development only.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Inference ---
# Recognition and synthesis. One key serves both.
ELEVENLABS_API_KEY=

# The model. Any OpenAI-compatible endpoint; xAI is one.
# Which model and how it behaves are in sonari.toml.
LLM_BASE_URL=https://api.x.ai/v1/chat/completions
LLM_API_KEY=

# --- Media plane ---
# Identifies this instance as the owner of the calls it runs.
RUNTIME_OWNER_ID=sonari-local
VOICE_SECRETS_KEY=dev-voice-secrets-key

# --- Runtime ---
RUST_LOG=info
